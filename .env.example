# ---- 基本設定 ----
SECRET_KEY=change-me-please
TIMEZONE=Asia/Tokyo

# ---- データベース ----
# できるだけ簡単に動かすため、ローカルは SQLite を推奨（ファイル作成）
# 本番では PostgreSQL のURLに置き換えてください。
# 例: postgresql://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=sqlite:///attendance.db

# ---- オプション ----
# CSV_EXPORT_MAX_DAYS=365
# SESSION_COOKIE_SECURE=true  # 本番HTTPSの場合のみ true
# REMEMBER_COOKIE_DAYS=14  # 「ログイン状態を保持する」を選んだ場合の保持日数
# REMEMBER_COOKIE_SECURE=true  # 省略時は SESSION_COOKIE_SECURE と同じ
# FLASK_DEBUG=true  # local only
# TRUST_X_FORWARDED_FOR=false  # enable only behind trusted reverse proxy

# ---- 開発用（local only）----
# 開発ユーザーの自動作成（DBが消えても復旧）
# ALLOW_DEV_LOGIN=true
# DEV_SEED_RESET_PASSWORDS=true  # 既存ユーザーのパスワードも毎回揃える場合
# DEV_ADMIN_USERNAME=admin
# DEV_ADMIN_PASSWORD=adminpass123
# DEV_TEST_USERNAME=testuser
# DEV_TEST_PASSWORD=testpass123
